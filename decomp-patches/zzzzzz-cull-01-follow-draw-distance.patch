Reason: port: the base Android port's distance culls (NPCs 2500, live actors 3500, map objects 4000, static props 6500; not retail) ignored the draw distance setting, so NPCs and objects popped in and out near Mario even at "1x (original)" (issue #1). They now apply only below the original draw distance (the Low preset's 0.7x); at 1x or more the game clips as on the GameCube. Their own settings (npc_draw_distance and the others) still win, 0 turns one off.
--- a/src/NPC/NpcBase.cpp
+++ b/src/NPC/NpcBase.cpp
@@ -764,13 +764,15 @@
 
 #include <stdlib.h>
 
+#include <port_cull.h>
+
 static f32 SMS_GetNpcDrawDistSq()
 {
 	static f32 s_distSq = -1.0f;
 	if (s_distSq < 0.0f) {
-		const char* e = getenv("SMS_NPC_DRAW_DISTANCE");
-		float dist = e ? (float)atof(e) : 2500.0f;
-		s_distSq = dist * dist;
+		// port: off at the original draw distance (port_cull.h)
+		float dist = port_cull_distance("SMS_NPC_DRAW_DISTANCE", 2500.0f);
+		s_distSq = dist > 0.0f ? dist * dist : 0.0f;
 	}
 	return s_distSq;
 }
