--- a/src/System/Application.cpp
+++ b/src/System/Application.cpp
@@ -1181,6 +1181,491 @@
 extern "C" void port_ach_game_frame(void);
 #endif
 
+#ifdef TARGET_PC
+#include <Map/Map.hpp>
+#include <Map/MapData.hpp>
+#include <Map/MapCollisionData.hpp>
+#include <sms_gx/gx_pc.h>
+#include <stdarg.h>
