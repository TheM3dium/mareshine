 TObjHitCheck* gpObjHitCheck;
 
+#ifdef TARGET_PC
+// Super Mario Sunburn's Ricco Harbour lists THideObjInfo objects (a TActor:
+// what an object switch reveals) among the hit actors. Retail reads their hit
+// fields past the 0x50-byte object, in the next heap block, where a pointer
+// gives an entry radius of almost 0 at 0x80000000. At a relocated MEM1
+// (Android) the same pointer is a huge radius: the actor enters every table
+// slot and the check list overflows into the next heap blocks. Leave objects
+// that are no THitActor out of the hit check.
+static bool portIsHitActorRef(JDrama::TNameRef* ref)
+{
+	return dynamic_cast<THitActor*>(ref) != nullptr;
+}
+
+static bool portIsHitActor(THitActor* actor)
+{
+	// The answer per class (vtable), direct-mapped: a stage has few classes.
+	static const void* s_vtables[64];
+	static bool s_answers[64];
+	const void* vtable = *reinterpret_cast<const void* const*>(actor);
+	u32 slot           = (u32)((uintptr_t)vtable >> 3) & 63;
+	if (s_vtables[slot] != vtable) {
+		s_answers[slot] = portIsHitActorRef(actor);
+		s_vtables[slot] = vtable;
+	}
+	return s_answers[slot];
+}
+
+// Entries in unk800 (7000 in retail, more for Eclipse).
+static u32 s_portCheckListCount;
+#endif
