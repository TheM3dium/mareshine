+	port_savestate_set_loading(sStateLoadPhase != STATE_LOAD_IDLE);
 
 	if (sStateLoadPhase == STATE_LOAD_FADE_OUT) {
 		// black, or a second at most (a fade the game took over)
@@ -1096,7 +1102,11 @@
