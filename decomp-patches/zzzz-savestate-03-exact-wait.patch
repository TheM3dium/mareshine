+++ b/src/System/Application.cpp
@@ -912,6 +912,11 @@
 static PortSaveStatePortable sStateLoad;
 static u8 sStateLoadPhase;
 static u16 sStateLoadFrames;
+// Frames an exact load has waited for the game's threads to stand as they
+// did when the state was saved (port_savestate_exact_waits); they settle in
+// a moment, and only after kStateLoadWaitFrames does it load the portable way.
+static u16 sStateLoadWaits;
+static const u16 kStateLoadWaitFrames = 60;
 static bool sStateLoadLeft; // the old stage has stopped playing
 
