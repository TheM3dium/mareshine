 // Exact with the binder-shaped TApplication::getFader() at the fader sites
 // and the BOOL TMarioGamePad::isSomethingPushed() (research c-r29).
+#ifdef TARGET_PC
+// Mareshine: a movie the player has not seen yet (which the game does not let
+// them skip) is skipped with START pressed twice. The first press asks the app
+// to show "Press START again to skip" for a few seconds; a second press while
+// it shows skips the movie. Seen movies keep the game's own single press.
+extern "C" __attribute__((weak)) int SDL_AndroidSendMessage(u32 command, int param);
+extern "C" u32 SDL_GetTicks(void);
+extern "C" void port_ach_unlock_id(const char* id); // platform/achievements
+static const u32 kMovieSkipCommand = 0x8003; // SunshineActivity.COMMAND_MOVIE_SKIP
+static const u32 kMovieSkipWindowMs = 3000;
+static int sMovieSkipMovie = -1;
+static u32 sMovieSkipAskedAt;
+
+static void movieSkipHint(bool show)
+{
+	if (SDL_AndroidSendMessage)
+		SDL_AndroidSendMessage(kMovieSkipCommand, show ? 1 : 0);
+}
+
+static bool movieSkipPressedTwice(const TMarioGamePad* pad)
+{
+	int movie = gpApplication.getMovie();
+	if (!pad->checkFrameMeaning(0x1)
+	    || TFlagManager::getInstance()->getBool(movie + 0x10391))
+		return false;
+	u32 now = SDL_GetTicks();
+	if (sMovieSkipMovie == movie && now - sMovieSkipAskedAt < kMovieSkipWindowMs) {
+		sMovieSkipMovie = -1;
+		movieSkipHint(false);
+		port_ach_unlock_id("sms.fun.impatient");
+		return true;
+	}
+	sMovieSkipMovie   = movie;
+	sMovieSkipAskedAt = now;
+	movieSkipHint(true);
+	return false;
+}
+#endif
