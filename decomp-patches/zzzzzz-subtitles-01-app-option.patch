+#ifdef TARGET_PC
+// Mareshine: the app's "Subtitles in cutscenes" (SMS_SUBTITLES) and the game's
+// own option are one setting: -1 leaves it to the game's option, 0 or 1 is the
+// app's, put into the game's option when the options load and taken back when
+// the player changes them (platform/port_runtime.cpp).
+extern "C" int port_subtitles_setting;
+extern "C" __attribute__((weak)) void port_subtitles_option_changed(int on);
+#endif
+
 const JMSMesgEntry* TMovieSubTitle::getCurEntry() const
 {
 #if defined(VERSION_GMSP01) || defined(VERSION_GMSE01)
 	// 0x90001 is the subtitle option flag (TOptionControl::writeValue writes
 	// the subtitle unit's value there), so subtitles off means no entry.
 	if (unk20->getMessageNum() <= unk24
+#ifdef TARGET_PC
+	    || !(port_subtitles_setting >= 0 ? port_subtitles_setting : TFlagManager::getInstance()->getFlag(0x90001)))
+#else
 	    || !TFlagManager::getInstance()->getFlag(0x90001))
+#endif
 		return nullptr;
 #else
 	if (unk20->getMessageNum() <= unk24)
