+		port_thp_draw_frame((ActivePlayer.dispTextureSet->frameNumber + ActivePlayer.initReadFrame)
+		                    % ActivePlayer.header.numFrames);
+#endif
 		THPGXYuv2RgbDraw(ActivePlayer.dispTextureSet->ytexture,
