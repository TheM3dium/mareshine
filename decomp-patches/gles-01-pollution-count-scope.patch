Reason: Android pollution callbacks complete the count; leave ordinary GX cumulative reads unchanged and avoid counting unrelated scene draws.
--- a/src/Map/PollutionCount.cpp
+++ b/src/Map/PollutionCount.cpp
@@ -1,4 +1,7 @@
 #include <Map/PollutionCount.hpp>
+#if defined(TARGET_PC) && defined(__ANDROID__)
+extern "C" void GXPC_FinishPixMetric(void);
+#endif
 #include <Map/PollutionLayer.hpp>
 #include <Map/PollutionManager.hpp>
 #include <MarioUtil/ReinitGX.hpp>
@@ -61,6 +64,11 @@
 	u32 discard;
 	GXReadPixMetric(&discard, &discard, &discard, &discard, mCounters[token],
 	                &discard);
+#if defined(TARGET_PC) && defined(__ANDROID__)
+	// This callback consumes the last read for this pollution count.
+	// Ordinary world drawing must not keep its counter shader active.
+	GXPC_FinishPixMetric();
+#endif
 	*mCounters[token] -= mPolygonCount[token] * 4;
 }
 
