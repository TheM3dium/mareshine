+#ifdef TARGET_PC
+// Super Mario Tropical Freeze slides on its ice floor (type 0x901) as on wet
+// ground: while Mario stands on it, it rewrites the first type isWetGround()
+// compares with (`cmplwi r4, 4`, at retail `addr`) to 0x901, the other three
+// (0x4004, 0x8004, 0xC004) still count.
+static inline bool MarioRunWetGround(const TBGCheckData* plane, unsigned int addr)
+{
+	u16 first = SMS_MOD_WORD(addr, 0x28040004u) & 0xFFFF;
+	return plane->mBGType == first || (plane->isWetGround() && plane->mBGType != 4);
+}
+#endif
