 void TMario::checkGraffito()
 {
+#ifdef TARGET_PC
+	// Super Mario Tropical Freeze (a branch at retail 0x80252BDC): its own
+	// checkGraffito, goop that throws Mario off Yoshi and fills FLUDD.
+	if (void* sms_mod_t_ = SMS_MOD_SITE(0x80252BDC)) {
+		((void (*)(TMario*))sms_mod_t_)(this);
+		return;
+	}
+#endif
 	const TBGCheckData* ground = MarioGraffitoGround(this);
 	if (ground->isIllegalData())
 		return;
