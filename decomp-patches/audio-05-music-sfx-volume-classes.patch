+#ifdef TARGET_PC
+// Port: which volume setting a voice follows, for the software mixer (platform/audio/README.md,
+// Music and SFX volume): 1 = music, 0 = sound effects. JAIBasic plays every sound effect as a child
+// track of one sequence, mSeSequence's; any other root sequence is background music. A channel with
+// no track to name counts as a sound effect.
+static u8 portVoiceClass(const TChannel* channel)
+{
+	TTrack* pool = TrackMgr::sTrackPool;
+	if (!channel->unk4 || !pool)
+		return 0;
+
+	// The track that owns the channel is the pool entry whose channel manager this is.
+	const uintptr_t first = (uintptr_t)&pool[0].mChannelUpdater;
+	const uintptr_t at    = (uintptr_t)channel->unk4;
+	if (at < first || (at - first) % sizeof(TTrack) != 0 || (at - first) / sizeof(TTrack) >= TrackMgr::sTrackCount)
+		return 0;
+
+	TTrack* root = &pool[(at - first) / sizeof(TTrack)];
+	for (int depth = 0; root->mParent && depth < 32; ++depth)
+		root = root->mParent;
+
+	JAISound* se = JAIBasic::basic ? JAIBasic::basic->mSeSequence : nullptr;
+	if (se && se->mState >= SOUNDSTATE_Started && se->getSeqParameter()
+	    && TrackMgr::handleToSeq(se->getSeqParameter()->mSeqHandle) == root)
+		return 0;
+	return 1;
+}
+#endif
