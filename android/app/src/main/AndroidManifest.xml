<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- the Wi-Fi sync finds the other device in the home network (NSD) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- installs its own updates (Updates.java), after the player confirms -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- largeHeap: room to install a mod (ModInstallActivity): Super Mario
         Eclipse's archive needs a 256 MB dictionary to unpack -->
    <application
        android:name=".SunshineApp"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:appCategory="game"
        android:icon="@mipmap/icon"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:enableOnBackInvokedCallback="false">

        <activity
            android:name="io.github.them3dium.mareshine.LauncherActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="io.github.them3dium.mareshine.SunshineActivity"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:alwaysRetainTaskState="true"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.them3dium.mareshine.game"
            android:preferMinimalPostProcessing="true">
        </activity>

        <!-- the package installer's answer to an update (Updates.java) -->
        <receiver
            android:name="io.github.them3dium.mareshine.Updates$InstallResult"
            android:exported="false" />

        <!-- compiles the shader cache while the menu shows (ShaderService) -->
        <service
            android:name="io.github.them3dium.mareshine.ShaderService"
            android:process=":shaders"
            android:exported="false" />

        <activity
            android:name="io.github.them3dium.mareshine.SettingsActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:label="Settings">
        </activity>

        <!-- the achievements, from the main menu and over the paused game (AchievementsActivity);
             it only reads files, so it runs in whichever process starts it -->
        <activity
            android:name="io.github.them3dium.mareshine.AchievementsActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false">
        </activity>

        <!-- syncing with another device in the same Wi-Fi (WifiSyncActivity) -->
        <activity
            android:name="io.github.them3dium.mareshine.WifiSyncActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false">
        </activity>

        <!-- the save state slots, over the paused game (SaveStatesActivity) -->
        <activity
            android:name="io.github.them3dium.mareshine.SaveStatesActivity"
            android:process=":game"
            android:taskAffinity="io.github.them3dium.mareshine.game"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false">
        </activity>

        <activity
            android:name="io.github.them3dium.mareshine.GameMenuActivity"
            android:process=":game"
            android:taskAffinity="io.github.them3dium.mareshine.game"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false">
        </activity>

        <activity
            android:name="io.github.them3dium.mareshine.ModsActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:label="Mods">
        </activity>

        <activity
            android:name="io.github.them3dium.mareshine.ModInstallActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:label="Mods">
        </activity>
        <activity
            android:name="io.github.them3dium.mareshine.ModPageActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:label="Mods">
        </activity>

        <activity
            android:name="io.github.them3dium.mareshine.LanguagePackActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:label="Languages">
        </activity>

        <activity
            android:name="io.github.them3dium.mareshine.CutsceneActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:label="HD cutscenes">
        </activity>

        <activity
            android:name="io.github.them3dium.mareshine.TexturePackActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:label="Texture pack">
        </activity>

        <activity
            android:name="io.github.them3dium.mareshine.IntroActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:label="Mareshine">
        </activity>

        <activity
            android:name="io.github.them3dium.mareshine.TouchLayoutActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:label="Touch layout">
        </activity>

        <activity
            android:name="io.github.them3dium.mareshine.StickCalibrationActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:label="Calibrate sticks">
        </activity>

        <activity
            android:name="io.github.them3dium.mareshine.ControllerSettingsActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:label="Controller Settings">
        </activity>
        <!-- the logs shared from Settings → OTHER → LOGS (LogShare) -->
        <provider
            android:name="io.github.them3dium.mareshine.LogShare$Provider"
            android:authorities="io.github.them3dium.mareshine.logs"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
