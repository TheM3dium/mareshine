<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (Android 8+): the launcher cuts it to its own shape, as it
     does other apps' icons, and may move the layers a little apart.
     Background: the beach scene at 76 of the layer's 108 dp, its edges carried
     on beyond it, so the shape shows all of it. Foreground: the logo, about
     60 % of the layer wide, inside the safe zone even for round icons.
     mipmap/icon.png (the same, as a rounded square) is for older launchers. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/icon_background" />
    <foreground android:drawable="@drawable/icon_foreground" />
</adaptive-icon>
