<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dusklight-style main menu entry: big, right-aligned text, gold bar when focused. -->
    <style name="DlMenuItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:background">@drawable/dl_menu_item</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/dl_menu_text</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <!-- the quick menu's bar entries (Dusklight's top bar) -->
    <style name="DlBarItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:background">@drawable/dl_bar_item</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/dl_menu_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
